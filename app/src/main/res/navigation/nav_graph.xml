<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.study.journalapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_createEntryFragment"
            app:destination="@id/createEntryFragment" />
    </fragment>
    <fragment
        android:id="@+id/listFragment"
        android:name="com.study.journalapp.list.ListFragment"
        android:label="Entries"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_createEntryFragment"
            app:destination="@id/createEntryFragment" />
        <action
            android:id="@+id/action_listFragment_to_viewEntryFragment"
            app:destination="@id/viewEntryFragment" />
    </fragment>
    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.study.journalapp.calendar.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" >
        <action
            android:id="@+id/action_calendarFragment_to_createEntryFragment"
            app:destination="@id/createEntryFragment" />
        <action
            android:id="@+id/action_calendarFragment_to_viewEntryFragment"
            app:destination="@id/viewEntryFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.study.journalapp.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/createEntryFragment"
        android:name="com.study.journalapp.createEntry.CreateEntryFragment"
        android:label="Create a new entry"
        tools:layout="@layout/fragment_create_entry" >
        <argument
            android:name="entryId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>
    <fragment
        android:id="@+id/viewEntryFragment"
        android:name="com.study.journalapp.viewEntry.ViewEntryFragment"
        android:label="Entry title"
        tools:layout="@layout/fragment_view_entry" >
        <argument
            android:name="entryId"
            app:argType="long" />
        <action
            android:id="@+id/action_viewEntryFragment_to_createEntryFragment"
            app:destination="@id/createEntryFragment" />
        <action
            android:id="@+id/action_viewEntryFragment_to_imageViewerFragment"
            app:destination="@id/imageViewerFragment" />
    </fragment>
    <fragment
        android:id="@+id/imageViewerFragment"
        android:name="com.study.journalapp.viewEntry.ImageViewerFragment"
        android:label="">
        <argument
            android:name="imagePaths"
            app:argType="string[]" />
        <argument
            android:name="startIndex"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
    <action
        android:id="@+id/action_global_createEntryFragment"
        app:destination="@id/createEntryFragment" />
</navigation>